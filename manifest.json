{
  "manifest_version": 3,
  "name": "KidsNote Backup",
  "version": "0.1.1",
  "description": "Back up KidsNote reports and original photos by date range.",
  "permissions": ["storage", "downloads", "tabs", "alarms"],
  "host_permissions": [
    "https://*.kidsnote.com/*",
    "https://up-kids-kage.kakao.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.kidsnote.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {"default_title": "KidsNote Backup", "default_popup": "popup.html"}
}
