{
  "manifest_version": 3,
  "name": "KidsNote Backup",
  "version": "0.1.0",
  "description": "Back up KidsNote reports and original photos by date range.",
  "permissions": ["storage", "downloads", "tabs", "alarms"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "KidsNote Backup", "default_popup": "popup.html"}
}
